{
  "name": "@shabd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=../.env scripts/seed-demo.ts",
    "admin": "tsx --env-file-if-exists=../.env scripts/admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@shabd/core": "*",
    "@types/pg": "^8.23.1",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.2.0"
  }
}
