{
  "name": "@shabd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:reset": "node -e \"require('fs').rmSync('data/shabd.db',{force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@shabd/core": "*",
    "better-sqlite3": "^12.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.2",
    "vitest": "^3.2.0"
  }
}
