# Copy to .env (root). All optional.
PORT=4000
# Postgres (Neon pooled URL in production). Local default if unset:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shabd
# Optional: Neon direct URL, preferred by db:migrate / db:seed
DATABASE_URL_UNPOOLED=
# Optional: pool size per instance (default 3 on Neon, 10 elsewhere)
PGPOOL_MAX=
# Tests: point at an existing Postgres instead of scripts/pg-local.mjs
TEST_DATABASE_URL=
# Optional: enables Claude sentence feedback. Without it the rule-based evaluator is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Optional: required code to register a new teacher account (empty = open registration)
TEACHER_INVITE_CODE=
# Seed a demo teacher/class/students on first start (dev only)
SEED_DEMO=1
