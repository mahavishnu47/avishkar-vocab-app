{
  "name": "shabd-mitra",
  "private": true,
  "version": "0.1.0",
  "description": "Shabd Mitra - daily vocabulary app for Maharashtra Std 5 (local MVP)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/core",
    "server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @shabd/server\" \"npm run dev -w @shabd/web\"",
    "build": "npm run build -w @shabd/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate:words": "node scripts/validate-words.mjs",
    "e2e": "node e2e/student-flow.mjs",
    "vercel-build": "node scripts/migrate-on-build.mjs && npm run build -w @shabd/web && node scripts/build-api.mjs",
    "deploy": "node scripts/deploy.mjs",
    "e2e:prod": "node e2e/student-flow.mjs --prod",
    "e2e:onboarding": "node e2e/onboarding.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:migrate": "npm run db:migrate -w @shabd/server",
    "db:seed": "npm run db:seed -w @shabd/server",
    "db:seed:demo": "npm run db:seed:demo -w @shabd/server",
    "admin": "npm run admin -w @shabd/server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
